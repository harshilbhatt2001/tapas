# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# generated by devenv claude.code
.mcp.json
.claude/settings.json
.claude/agents/
.claude/worktrees/
.worktrees/

# rust
/target

# nix
result
result-*

# Google OAuth client and token caches: never commit copies
client_secret*.json
tokens*.json
.env*

# Server secrets copied by nixos-anywhere --extra-files
/secrets

# Android SDK paths and state written by devenv's android module
/local.properties

# Local server state for `devenv up`
/.dev/
/.android/
