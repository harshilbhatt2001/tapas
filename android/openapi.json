{
  "openapi": "3.1.0",
  "info": {
    "title": "tapas",
    "description": "tapas server: JSON API, sign-in, source sync.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/course": {
      "get": {
        "operationId": "course",
        "responses": {
          "200": {
            "description": "Every goal's status and the master's verdict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/goals": {
      "get": {
        "operationId": "goals",
        "responses": {
          "200": {
            "description": "The goal tree, flat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Goal"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "post": {
        "operationId": "create_goal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Goal"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid goal"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/goals/{id}": {
      "put": {
        "operationId": "update_goal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The goal's id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Goal"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid goal"
          },
          "404": {
            "description": "No such goal"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "delete": {
        "operationId": "delete_goal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The goal's id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted with its subtree"
          },
          "400": {
            "description": "The master goal cannot be deleted"
          },
          "404": {
            "description": "No such goal"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/google/grants": {
      "post": {
        "operationId": "connect_google",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectGoogle"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Connected"
          },
          "400": {
            "description": "Google refused the auth code"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The account and its Google grants",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/recent": {
      "get": {
        "operationId": "recent",
        "responses": {
          "200": {
            "description": "Latest measurements and workouts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recent"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/series": {
      "get": {
        "operationId": "series",
        "responses": {
          "200": {
            "description": "Every series",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Series"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "post": {
        "operationId": "create_series",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeriesInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Series"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/series/{id}/entries/{day}": {
      "put": {
        "operationId": "put_manual_entry",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The series' id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "day",
            "in": "path",
            "description": "The day the value is for",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualEntry"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Stored, replacing that day's value"
          },
          "400": {
            "description": "The series is not fed manually"
          },
          "404": {
            "description": "No such series"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/series/{id}/weeks": {
      "get": {
        "operationId": "series_weeks",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The series' id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Weekly values, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Observation"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such series"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/session": {
      "post": {
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionToken"
                }
              }
            }
          },
          "401": {
            "description": "Not the allowed Google account"
          }
        }
      },
      "delete": {
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The server is up",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Aggregation": {
        "type": "string",
        "description": "How a week's readings collapse into one value.",
        "enum": [
          "level",
          "sum"
        ]
      },
      "ConnectGoogle": {
        "type": "object",
        "required": [
          "api",
          "server_auth_code"
        ],
        "properties": {
          "api": {
            "$ref": "#/components/schemas/GoogleApi"
          },
          "server_auth_code": {
            "type": "string",
            "description": "From the app's authorization request with offline access for the server's Web client."
          }
        }
      },
      "Course": {
        "type": "object",
        "description": "The whole tree's status on one day.",
        "required": [
          "nodes",
          "master"
        ],
        "properties": {
          "master": {
            "$ref": "#/components/schemas/MasterVerdict"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeStatus"
            },
            "description": "One per goal, master included."
          }
        }
      },
      "Feed": {
        "type": "string",
        "description": "Where a series' readings come from.",
        "enum": [
          "manual",
          "body_weight",
          "training_hours"
        ]
      },
      "Goal": {
        "type": "object",
        "description": "A node in the goal tree. The root is the single [`GoalKind::Master`]; checkpoints are child\ngoals stacked under their parent by due date.",
        "required": [
          "id",
          "title",
          "kind",
          "weight"
        ],
        "properties": {
          "capacity_hours": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Master only: total weekly hours available."
          },
          "done_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Milestones: the day it was ticked done."
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "$ref": "#/components/schemas/GoalKind"
          },
          "max_ramp": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Largest allowed week-on-week rise of the weekly amount, as a fraction (0.1 = +10 %)."
          },
          "parent_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "series_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Controlled goals: the series steered on a straight path from `start_value` to\n`target_value`."
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Where the reference path starts. A checkpoint without one starts where the previous\ncheckpoint in its stack ends, in date and value."
          },
          "start_value": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "For an [`Aggregation::Sum`] series, a running total since `start`."
          },
          "target_value": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "The goal merges once its series reaches this. For an [`Aggregation::Sum`] series, a\nrunning total since `start`."
          },
          "title": {
            "type": "string"
          },
          "weekly_hours": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Weekly time this goal needs."
          },
          "weight": {
            "type": "number",
            "format": "double",
            "description": "Share of the parent's error."
          }
        }
      },
      "GoalInput": {
        "type": "object",
        "description": "A goal as the app creates or edits it: every [`Goal`] field but the id.",
        "required": [
          "title",
          "kind",
          "weight"
        ],
        "properties": {
          "capacity_hours": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Master only: total weekly hours available."
          },
          "done_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Milestones: the day it was ticked done."
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "kind": {
            "$ref": "#/components/schemas/GoalKind"
          },
          "max_ramp": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Largest allowed week-on-week rise of the weekly amount, as a fraction (0.1 = +10 %)."
          },
          "parent_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "series_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Controlled goals: the series steered on a straight path from `start_value` to\n`target_value`."
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Where the reference path starts; without one a checkpoint starts where the previous\ncheckpoint in its stack ends, in date and value."
          },
          "start_value": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "For a `sum` series, a running total since `start`."
          },
          "target_value": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "The goal merges once its series reaches this. For a `sum` series, a running total since\n`start`."
          },
          "title": {
            "type": "string"
          },
          "weekly_hours": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Weekly time this goal needs."
          },
          "weight": {
            "type": "number",
            "format": "double",
            "description": "Share of the parent's error."
          }
        }
      },
      "GoalKind": {
        "type": "string",
        "enum": [
          "master",
          "controlled",
          "milestone"
        ]
      },
      "GoogleApi": {
        "type": "string",
        "description": "A Google API with its own grant. The Health API rejects access tokens that also carry other\nAPIs' scopes (`DISALLOWED_OAUTH_SCOPES`), so each API is consented and refreshed apart.",
        "enum": [
          "health",
          "calendar"
        ]
      },
      "GrantStatus": {
        "type": "object",
        "required": [
          "api",
          "granted_at",
          "needs_consent"
        ],
        "properties": {
          "api": {
            "$ref": "#/components/schemas/GoogleApi"
          },
          "granted_at": {
            "type": "string",
            "format": "date-time"
          },
          "needs_consent": {
            "type": "boolean",
            "description": "Google revoked the grant; the app asks for consent again."
          },
          "sync_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "The last sync's error; `None` once a sync succeeds."
          },
          "synced_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "LoopTerms": {
        "type": "object",
        "description": "A loop's error terms, all in days.",
        "required": [
          "p",
          "i",
          "d"
        ],
        "properties": {
          "d": {
            "type": "number",
            "format": "double",
            "description": "Change of the gap per week; positive means falling behind."
          },
          "i": {
            "type": "number",
            "format": "double",
            "description": "The mean gap over a rolling window."
          },
          "p": {
            "type": "number",
            "format": "double",
            "description": "The gap now."
          }
        }
      },
      "ManualEntry": {
        "type": "object",
        "description": "A manual series' value for one day.",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "MasterVerdict": {
        "type": "object",
        "description": "The master goal's judgement of the whole tree.",
        "required": [
          "days_behind",
          "needed_hours",
          "overcommitted",
          "mode",
          "drifting"
        ],
        "properties": {
          "capacity_hours": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "days_behind": {
            "type": "number",
            "format": "double",
            "description": "The weighted error of the whole tree."
          },
          "drifting": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Goals whose error keeps growing."
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "needed_hours": {
            "type": "number",
            "format": "double",
            "description": "Weekly hours the active goals need."
          },
          "overcommitted": {
            "type": "boolean",
            "description": "`needed_hours` exceeds `capacity_hours`."
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "email",
          "grants"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantStatus"
            }
          }
        }
      },
      "Measurement": {
        "type": "object",
        "description": "One reading of a metric at an instant.",
        "required": [
          "metric",
          "at",
          "value",
          "source"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "metric": {
            "$ref": "#/components/schemas/Metric"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "value": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Metric": {
        "type": "string",
        "enum": [
          "body_weight_kg"
        ]
      },
      "Mode": {
        "type": "string",
        "description": "Which plan the week runs.",
        "enum": [
          "a",
          "b"
        ]
      },
      "NodeState": {
        "type": "string",
        "enum": [
          "on_course",
          "ahead",
          "behind",
          "conflict",
          "sensor_stale",
          "pending",
          "merged",
          "upcoming",
          "due_soon",
          "done",
          "overdue"
        ]
      },
      "NodeStatus": {
        "type": "object",
        "description": "One goal's status.",
        "required": [
          "goal_id",
          "state",
          "path"
        ],
        "properties": {
          "conflict": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why catching up breaks a limit."
          },
          "days_behind": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Negative when ahead; `None` while pending, done or stale."
          },
          "goal_id": {
            "type": "integer",
            "format": "int64"
          },
          "needed_per_week": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Weekly amount that gets back to the path, clamped to the goal's limits."
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "description": "The reference path, one point per week."
          },
          "projected_arrival": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "slack_days": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "How far the rest of the stack can slip before the parent's due date."
          },
          "state": {
            "$ref": "#/components/schemas/NodeState"
          },
          "terms": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LoopTerms"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Observation": {
        "type": "object",
        "description": "A series' value for one ISO week.",
        "required": [
          "week",
          "value"
        ],
        "properties": {
          "value": {
            "type": "number",
            "format": "double"
          },
          "week": {
            "type": "string",
            "format": "date",
            "description": "The ISO week's Monday."
          }
        }
      },
      "Recent": {
        "type": "object",
        "required": [
          "measurements",
          "workouts"
        ],
        "properties": {
          "measurements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Measurement"
            }
          },
          "workouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workout"
            }
          }
        }
      },
      "Series": {
        "type": "object",
        "description": "A weekly series a controlled goal can steer.",
        "required": [
          "id",
          "name",
          "unit",
          "aggregation",
          "feed"
        ],
        "properties": {
          "aggregation": {
            "$ref": "#/components/schemas/Aggregation"
          },
          "feed": {
            "$ref": "#/components/schemas/Feed"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "SeriesInput": {
        "type": "object",
        "description": "A user-created series; its feed is always manual.",
        "required": [
          "name",
          "unit",
          "aggregation"
        ],
        "properties": {
          "aggregation": {
            "$ref": "#/components/schemas/Aggregation"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "SessionToken": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "SignIn": {
        "type": "object",
        "required": [
          "id_token"
        ],
        "properties": {
          "id_token": {
            "type": "string",
            "description": "A Google ID token issued for the server's Web client id."
          }
        }
      },
      "Source": {
        "type": "string",
        "description": "Where a measurement or workout was read from.",
        "enum": [
          "google_health",
          "manual"
        ]
      },
      "Workout": {
        "type": "object",
        "description": "A completed activity as its source reported it.",
        "required": [
          "source",
          "source_id",
          "activity",
          "start",
          "end"
        ],
        "properties": {
          "active_secs": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "activity": {
            "type": "string",
            "description": "The source's activity type, e.g. Google's `RUNNING`."
          },
          "avg_hr": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "distance_m": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "kcal": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "source_id": {
            "type": "string",
            "description": "The source's own id, unique per source."
          },
          "start": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
